#!/bin/sh
# luci-app-vlessmanager/root/usr/bin/vlessmanager
# VlessManager — основной скрипт управления

set -o pipefail 2>/dev/null || true

VERSION="1.0.0"
PROG_NAME="vlessmanager"
LOCK_FILE="/var/lock/${PROG_NAME}.lock"
PID_FILE="/var/run/${PROG_NAME}/singbox.pid"
RUN_DIR="/var/run/${PROG_NAME}"
STATUS_FILE="${RUN_DIR}/status.json"

# ===================== УТИЛИТЫ =====================

log() {
    local level="$1"; shift
    local log_file
    log_file=$(uci -q get vlessmanager.main.log_file 2>/dev/null || echo "/var/log/vlessmanager.log")
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [${level}] $*" >> "$log_file"
}

log_info()  { log "INFO"  "$@"; }
log_warn()  { log "WARN"  "$@"; }
log_error() { log "ERROR" "$@"; }
log_debug() { log "DEBUG" "$@"; }

acquire_lock() {
    local attempts=0
    while [ -f "$LOCK_FILE" ]; do
        local lock_pid
        lock_pid=$(cat "$LOCK_FILE" 2>/dev/null)
        if [ -n "$lock_pid" ] && ! kill -0 "$lock_pid" 2>/dev/null; then
            rm -f "$LOCK_FILE"; break
        fi
        attempts=$((attempts + 1))
        [ "$attempts" -ge 30 ] && { log_error "Cannot acquire lock"; return 1; }
        sleep 1
    done
    echo $$ > "$LOCK_FILE"
}

release_lock() { rm -f "$LOCK_FILE"; }
trap 'release_lock' EXIT

ensure_dirs() {
    mkdir -p "$RUN_DIR"
    mkdir -p "$(dirname "$(uci -q get vlessmanager.main.log_file 2>/dev/null || echo '/var/log/vlessmanager.log')")"
}

get_config() {
    local val
    val=$(uci -q get "vlessmanager.main.${1}" 2>/dev/null)
    [ -z "$val" ] && echo "$2" || echo "$val"
}

update_status() {
    cat > "$STATUS_FILE" <<-EOF
{
    "status": "${1}",
    "message": "${2}",
    "active_server": "${3}",
    "server_count": ${4:-0},
    "last_update": "${5}",
    "timestamp": "$(date '+%Y-%m-%d %H:%M:%S')",
    "version": "${VERSION}"
}
EOF
}

# ===================== ПАРСЕР VLESS =====================

urldecode() {
    printf '%b' "$(echo "$1" | sed 's/+/ /g; s/%\([0-9a-fA-F][0-9a-fA-F]\)/\\x\1/g')"
}

parse_vless_link() {
    local link="$1" idx="$2"
    local stripped="${link#vless://}"

    # Фрагмент #NAME
    local name=""
    case "$stripped" in *"#"*)
        name=$(urldecode "$(echo "$stripped" | sed 's/.*#//')")
        stripped=$(echo "$stripped" | sed 's/#.*//')
    ;; esac

    # Параметры ?params
    local params=""
    case "$stripped" in *"?"*)
        params=$(echo "$stripped" | sed 's/.*?//')
        stripped=$(echo "$stripped" | sed 's/?.*//')
    ;; esac

    local uuid host port
    uuid=$(echo "$stripped" | sed 's/@.*//')
    local hostport
    hostport=$(echo "$stripped" | sed 's/.*@//')

    case "$hostport" in
        "["*"]"*)
            host=$(echo "$hostport" | sed 's/\[\(.*\)\].*/\1/')
            port=$(echo "$hostport" | sed 's/.*\]://')
            ;;
        *)
            host=$(echo "$hostport" | cut -d: -f1)
            port=$(echo "$hostport" | cut -d: -f2)
            ;;
    esac
    [ -z "$port" ] && port="443"
    [ -z "$name" ] && name="vless-${idx}"

    local security="" type="" sni="" fp="" pbk="" sid="" flow=""
    local path="" ws_host="" xhttp_mode="" grpc_sn="" alpn="" insecure=""

    local OLD_IFS="$IFS"; IFS='&'
    for param in $params; do
        local key="${param%%=*}" val="${param#*=}"
        val=$(urldecode "$val")
        case "$key" in
            security)       security="$val" ;;
            type)           type="$val" ;;
            sni)            sni="$val" ;;
            fp)             fp="$val" ;;
            pbk)            pbk="$val" ;;
            sid)            sid="$val" ;;
            flow)           flow="$val" ;;
            path)           path="$val" ;;
            host)           ws_host="$val" ;;
            mode)           xhttp_mode="$val" ;;
            serviceName)    grpc_sn="$val" ;;
            alpn)           alpn="$val" ;;
            allowInsecure)  insecure="$val" ;;
        esac
    done
    IFS="$OLD_IFS"

    [ -z "$type" ] && type="tcp"
    [ -z "$security" ] && security="none"
    [ -z "$fp" ] && fp="chrome"

    local tag="proxy-${idx}"
    local json="{\"type\":\"vless\",\"tag\":\"${tag}\",\"server\":\"${host}\",\"server_port\":${port},\"uuid\":\"${uuid}\""

    # Flow
    [ -n "$flow" ] && [ "$flow" != "none" ] && json="${json},\"flow\":\"${flow}\""

    # TLS
    if [ "$security" = "tls" ] || [ "$security" = "reality" ]; then
        local tls=",\"tls\":{\"enabled\":true"
        [ -n "$sni" ] && tls="${tls},\"server_name\":\"${sni}\""

        if [ -n "$alpn" ]; then
            local aa="" OLD2="$IFS"; IFS=','
            for a in $alpn; do
                [ -n "$aa" ] && aa="${aa},"
                aa="${aa}\"${a}\""
            done; IFS="$OLD2"
            tls="${tls},\"alpn\":[${aa}]"
        fi

        [ "$insecure" = "1" ] || [ "$insecure" = "true" ] && tls="${tls},\"insecure\":true"
        [ -n "$fp" ] && tls="${tls},\"utls\":{\"enabled\":true,\"fingerprint\":\"${fp}\"}"

        if [ "$security" = "reality" ]; then
            tls="${tls},\"reality\":{\"enabled\":true"
            [ -n "$pbk" ] && tls="${tls},\"public_key\":\"${pbk}\""
            [ -n "$sid" ] && tls="${tls},\"short_id\":\"${sid}\""
            tls="${tls}}"
        fi
        tls="${tls}}"
        json="${json}${tls}"
    fi

    # Transport
    case "$type" in
        ws)
            local t=",\"transport\":{\"type\":\"ws\""
            [ -n "$path" ] && t="${t},\"path\":\"${path}\""
            [ -n "$ws_host" ] && t="${t},\"headers\":{\"Host\":\"${ws_host}\"}"
            t="${t}}"; json="${json}${t}"
            ;;
        xhttp|splithttp)
            local t=",\"transport\":{\"type\":\"httpupgrade\""
            [ -n "$path" ] && t="${t},\"path\":\"${path}\""
            [ -n "$ws_host" ] && t="${t},\"host\":\"${ws_host}\""
            t="${t}}"; json="${json}${t}"
            ;;
        grpc)
            local t=",\"transport\":{\"type\":\"grpc\""
            [ -n "$grpc_sn" ] && t="${t},\"service_name\":\"${grpc_sn}\""
            t="${t}}"; json="${json}${t}"
            ;;
        http|h2)
            local t=",\"transport\":{\"type\":\"http\""
            [ -n "$path" ] && t="${t},\"path\":\"${path}\""
            [ -n "$ws_host" ] && t="${t},\"host\":[\"${ws_host}\"]"
            t="${t}}"; json="${json}${t}"
            ;;
    esac

    json="${json}}"
    echo "${json}|${tag}|${name}|${security}|${type}"
}

# ===================== ПОДПИСКА =====================

fetch_subscription() {
    local url cache_file
    url=$(get_config subscribe_url "")
    cache_file=$(get_config cache_file "/var/run/vlessmanager/subscribe_cache.txt")

    [ -z "$url" ] && { log_error "Subscribe URL is empty"; return 1; }

    log_info "Fetching subscription from: ${url}"
    local temp="${RUN_DIR}/subscribe_temp.txt"

    if ! curl -fsSL --connect-timeout 15 --max-time 60 -o "$temp" "$url" 2>/dev/null; then
        log_error "Failed to fetch subscription"; rm -f "$temp"; return 1
    fi

    # Проверка на base64
    local first
    first=$(head -1 "$temp" 2>/dev/null)
    if echo "$first" | grep -qE '^[A-Za-z0-9+/=]+$' && ! echo "$first" | grep -q "://"; then
        local decoded
        if decoded=$(base64 -d "$temp" 2>/dev/null) && echo "$decoded" | head -1 | grep -q "://"; then
            echo "$decoded" > "$temp"
            log_info "Decoded base64 subscription"
        fi
    fi

    grep -E '^vless://' "$temp" > "$cache_file" 2>/dev/null
    rm -f "$temp"

    local count
    count=$(wc -l < "$cache_file" 2>/dev/null | tr -d ' ')
    [ "$count" -eq 0 ] && { log_error "No VLESS configs found"; return 1; }

    log_info "Fetched ${count} VLESS configs"
}

filter_configs() {
    local cache_file include_regex exclude_regex transport_filter
    cache_file=$(get_config cache_file "/var/run/vlessmanager/subscribe_cache.txt")
    include_regex=$(get_config include_regex "")
    exclude_regex=$(get_config exclude_regex "")
    transport_filter=$(get_config transport_filter "all")

    [ ! -f "$cache_file" ] && { log_error "Cache file not found"; return 1; }

    local filtered="${RUN_DIR}/filtered_configs.txt"
    cp "$cache_file" "$filtered"

    # Include regex
    if [ -n "$include_regex" ]; then
        local temp="${RUN_DIR}/filter_temp.txt"; : > "$temp"
        while IFS= read -r line; do
            local cn=""
            case "$line" in *"#"*) cn=$(urldecode "$(echo "$line" | sed 's/.*#//')") ;; esac
            echo "$cn" | grep -qE "$include_regex" && echo "$line" >> "$temp"
        done < "$filtered"
        mv "$temp" "$filtered"
        log_info "After include filter: $(wc -l < "$filtered" | tr -d ' ') configs"
    fi

    # Exclude regex
    if [ -n "$exclude_regex" ]; then
        local temp="${RUN_DIR}/filter_temp.txt"; : > "$temp"
        while IFS= read -r line; do
            local cn=""
            case "$line" in *"#"*) cn=$(urldecode "$(echo "$line" | sed 's/.*#//')") ;; esac
            echo "$cn" | grep -qE "$exclude_regex" || echo "$line" >> "$temp"
        done < "$filtered"
        mv "$temp" "$filtered"
        log_info "After exclude filter: $(wc -l < "$filtered" | tr -d ' ') configs"
    fi

    # Transport filter
    if [ "$transport_filter" != "all" ] && [ -n "$transport_filter" ]; then
        local temp="${RUN_DIR}/filter_temp.txt"; : > "$temp"
        while IFS= read -r line; do
            local pp=""
            case "$line" in *"?"*) pp=$(echo "$line" | sed 's/.*?//;s/#.*//') ;; esac
            local lt="tcp"
            local tv
            tv=$(echo "$pp" | tr '&' '\n' | grep '^type=' | head -1 | cut -d= -f2)
            [ -n "$tv" ] && lt="$tv"
            local match=0 OLD3="$IFS"; IFS=','
            for ft in $transport_filter; do
                [ "$ft" = "$lt" ] && { match=1; break; }
            done; IFS="$OLD3"
            [ "$match" -eq 1 ] && echo "$line" >> "$temp"
        done < "$filtered"
        mv "$temp" "$filtered"
        log_info "After transport filter: $(wc -l < "$filtered" | tr -d ' ') configs"
    fi

    local fc
    fc=$(wc -l < "$filtered" 2>/dev/null | tr -d ' ')
    [ "$fc" -eq 0 ] && { log_warn "No configs after filtering"; return 1; }
    log_info "Final filtered configs: ${fc}"
}

# ===================== SING-BOX КОНФИГ =====================

generate_singbox_config() {
    local filtered="${RUN_DIR}/filtered_configs.txt"
    local singbox_config
    singbox_config=$(get_config singbox_config "/var/run/vlessmanager/singbox.json")

    [ ! -f "$filtered" ] && { log_error "Filtered configs not found"; return 1; }

    local urltest_url urltest_interval urltest_tolerance urltest_timeout
    local tun_address tun_address6 tun_mtu interface_name dns_server
    local log_level tun_stack

    urltest_url=$(get_config urltest_url "https://www.gstatic.com/generate_204")
    urltest_interval=$(get_config urltest_interval "300")
    urltest_tolerance=$(get_config urltest_tolerance "50")
    urltest_timeout=$(get_config urltest_timeout "5000")
    tun_address=$(get_config tun_address "172.19.0.1/30")
    tun_address6=$(get_config tun_address6 "fdfe:dcba:9876::1/126")
    tun_mtu=$(get_config tun_mtu "9000")
    interface_name=$(get_config interface_name "vlessmanager")
    dns_server=$(get_config dns_server "1.1.1.1")
    log_level=$(get_config log_level "warn")
    tun_stack=$(get_config tun_stack "mixed")

    local outbounds_json="" tags_json="" idx=0

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        line=$(echo "$line" | tr -d '\r')
        idx=$((idx + 1))

        local parsed
        parsed=$(parse_vless_link "$line" "$idx")
        [ -z "$parsed" ] && { log_warn "Failed to parse config #${idx}"; continue; }

        local oj tag
        oj=$(echo "$parsed" | cut -d'|' -f1)
        tag=$(echo "$parsed" | cut -d'|' -f2)

        [ -n "$outbounds_json" ] && outbounds_json="${outbounds_json},"
        outbounds_json="${outbounds_json}${oj}"
        [ -n "$tags_json" ] && tags_json="${tags_json},"
        tags_json="${tags_json}\"${tag}\""
    done < "$filtered"

    [ -z "$outbounds_json" ] && { log_error "No valid outbounds"; return 1; }

    cat > "$singbox_config" <<SINGBOXEOF
{
    "log": {
        "level": "${log_level}",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "remote-dns",
                "address": "https://${dns_server}/dns-query",
                "address_resolver": "local-dns",
                "detour": "url-test-group"
            },
            {
                "tag": "local-dns",
                "address": "local"
            }
        ],
        "rules": [
            {
                "outbound": "any",
                "server": "local-dns"
            }
        ],
        "strategy": "prefer_ipv4"
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "interface_name": "${interface_name}",
            "address": [
                "${tun_address}",
                "${tun_address6}"
            ],
            "mtu": ${tun_mtu},
            "auto_route": false,
            "stack": "${tun_stack}",
            "sniff": true,
            "sniff_override_destination": false
        }
    ],
    "outbounds": [
        {
            "type": "urltest",
            "tag": "url-test-group",
            "outbounds": [${tags_json}],
            "url": "${urltest_url}",
            "interval": "${urltest_interval}s",
            "tolerance": ${urltest_tolerance},
            "idle_timeout": "30m"
        },
        ${outbounds_json},
        {
            "type": "direct",
            "tag": "direct"
        },
        {
            "type": "block",
            "tag": "block"
        },
        {
            "type": "dns",
            "tag": "dns-out"
        }
    ],
    "route": {
        "rules": [
            {
                "protocol": "dns",
                "outbound": "dns-out"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            }
        ],
        "default_mark": 100,
        "auto_detect_interface": true
    }
}
SINGBOXEOF

    if command -v sing-box >/dev/null 2>&1; then
        if ! sing-box check -c "$singbox_config" 2>/dev/null; then
            log_error "Config validation failed: $(sing-box check -c "$singbox_config" 2>&1)"
            return 1
        fi
    fi

    log_info "Generated sing-box config with ${idx} outbounds"
}

# ===================== ИНТЕРФЕЙС И FIREWALL =====================

setup_network_interface() {
    local interface_name
    interface_name=$(get_config interface_name "vlessmanager")

    if ! uci -q get "network.${interface_name}" >/dev/null 2>&1; then
        uci set "network.${interface_name}=interface"
        uci set "network.${interface_name}.proto=none"
        uci set "network.${interface_name}.device=${interface_name}"
        uci set "network.${interface_name}.defaultroute=0"
        uci set "network.${interface_name}.peerdns=0"
        uci set "network.${interface_name}.delegate=0"
        uci commit network
        log_info "Created network interface: ${interface_name}"
    fi

    local fw_exists=0 i=0
    while true; do
        local zn
        zn=$(uci -q get "firewall.@zone[${i}].name" 2>/dev/null)
        [ -z "$zn" ] && break
        [ "$zn" = "$interface_name" ] && { fw_exists=1; break; }
        i=$((i + 1))
    done

    if [ "$fw_exists" -eq 0 ]; then
        uci add firewall zone
        uci set "firewall.@zone[-1].name=${interface_name}"
        uci set "firewall.@zone[-1].input=REJECT"
        uci set "firewall.@zone[-1].output=ACCEPT"
        uci set "firewall.@zone[-1].forward=REJECT"
        uci set "firewall.@zone[-1].masq=0"
        uci set "firewall.@zone[-1].mtu_fix=1"
        uci add_list "firewall.@zone[-1].network=${interface_name}"

        uci add firewall forwarding
        uci set "firewall.@forwarding[-1].src=lan"
        uci set "firewall.@forwarding[-1].dest=${interface_name}"

        uci commit firewall
        log_info "Created firewall zone: ${interface_name}"
    fi
}

remove_network_interface() {
    local interface_name
    interface_name=$(get_config interface_name "vlessmanager")

    uci -q delete "network.${interface_name}" 2>/dev/null
    uci commit network 2>/dev/null

    local i=0
    while true; do
        local zn
        zn=$(uci -q get "firewall.@zone[${i}].name" 2>/dev/null)
        [ -z "$zn" ] && break
        if [ "$zn" = "$interface_name" ]; then
            uci delete "firewall.@zone[${i}]"; break
        fi
        i=$((i + 1))
    done

    i=0
    while true; do
        local fd
        fd=$(uci -q get "firewall.@forwarding[${i}].dest" 2>/dev/null)
        [ -z "$fd" ] && break
        if [ "$fd" = "$interface_name" ]; then
            uci delete "firewall.@forwarding[${i}]"; break
        fi
        i=$((i + 1))
    done
    uci commit firewall 2>/dev/null
    log_info "Removed interface: ${interface_name}"
}

# ===================== SING-BOX CONTROL =====================

start_singbox() {
    local singbox_config
    singbox_config=$(get_config singbox_config "/var/run/vlessmanager/singbox.json")
    [ ! -f "$singbox_config" ] && { log_error "Config not found"; return 1; }

    stop_singbox
    log_info "Starting sing-box..."

    sing-box run -c "$singbox_config" &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    sleep 3

    if kill -0 "$pid" 2>/dev/null; then
        log_info "Sing-box started PID: ${pid}"
        /etc/init.d/network reload 2>/dev/null &

        local sc
        sc=$(wc -l < "${RUN_DIR}/filtered_configs.txt" 2>/dev/null | tr -d ' ')
        update_status "running" "Sing-box running, healthy" "" "$sc" "$(date '+%Y-%m-%d %H:%M:%S')"

        # Запускаем healthcheck демон
        /usr/bin/vlessmanager-urltest start
        return 0
    else
        log_error "Sing-box failed to start"
        rm -f "$PID_FILE"
        update_status "error" "Sing-box failed to start" "" "0" ""
        return 1
    fi
}

stop_singbox() {
    # Останавливаем healthcheck
    /usr/bin/vlessmanager-urltest stop 2>/dev/null

    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            log_info "Stopping sing-box PID: ${pid}"
            kill "$pid" 2>/dev/null; sleep 2
            kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi
    killall -q sing-box 2>/dev/null
    update_status "stopped" "Stopped" "" "0" ""
}

is_singbox_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null
}

# ===================== ПОЛНЫЙ ЦИКЛ =====================

full_update() {
    log_info "Starting full update..."
    fetch_subscription || { update_status "error" "Fetch failed" "" "0" ""; return 1; }
    filter_configs || { update_status "error" "No configs after filter" "" "0" ""; return 1; }
    generate_singbox_config || { update_status "error" "Config gen failed" "" "0" ""; return 1; }
    setup_network_interface
    start_singbox || return 1
    log_info "Full update completed"
}

setup_cron() {
    local enabled update_interval
    enabled=$(get_config enabled "0")
    update_interval=$(get_config update_interval "60")

    crontab -l 2>/dev/null | grep -v "$PROG_NAME" | crontab - 2>/dev/null

    if [ "$enabled" = "1" ]; then
        local cron_entry
        if [ "$update_interval" -le 59 ]; then
            cron_entry="*/${update_interval} * * * * /usr/bin/${PROG_NAME} cron_update"
        else
            local h=$((update_interval / 60))
            [ "$h" -ge 1 ] && cron_entry="0 */${h} * * * /usr/bin/${PROG_NAME} cron_update"
            [ "$h" -lt 1 ] && cron_entry="*/${update_interval} * * * * /usr/bin/${PROG_NAME} cron_update"
        fi

        (crontab -l 2>/dev/null; echo "$cron_entry") | crontab - 2>/dev/null
        log_info "Cron: update every ${update_interval}min"
    fi
}

# ===================== RPC =====================

rpc_get_status() {
    if [ -f "$STATUS_FILE" ]; then
        # Добавляем healthcheck информацию
        local hc_status
        hc_status=$(/usr/bin/vlessmanager-urltest status 2>/dev/null || echo '{"running":false}')
        local base
        base=$(cat "$STATUS_FILE")
        # Вставляем healthcheck в JSON
        echo "$base" | sed "s/}$/,\"healthcheck\":${hc_status}}/"
    else
        echo '{"status":"unknown","message":"No status","server_count":0,"healthcheck":{"running":false}}'
    fi
}

rpc_get_servers() {
    local filtered="${RUN_DIR}/filtered_configs.txt"
    if [ ! -f "$filtered" ]; then
        echo '{"servers":[],"count":0}'; return
    fi

    local servers="[" first=1 idx=0
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        line=$(echo "$line" | tr -d '\r')
        idx=$((idx + 1))

        local name=""
        case "$line" in *"#"*) name=$(urldecode "$(echo "$line" | sed 's/.*#//')") ;; esac
        [ -z "$name" ] && name="server-${idx}"

        local pp=""
        case "$line" in *"?"*) pp=$(echo "$line" | sed 's/.*?//;s/#.*//') ;; esac
        local transport="tcp" security="none"
        local t s
        t=$(echo "$pp" | tr '&' '\n' | grep '^type=' | head -1 | cut -d= -f2)
        [ -n "$t" ] && transport="$t"
        s=$(echo "$pp" | tr '&' '\n' | grep '^security=' | head -1 | cut -d= -f2)
        [ -n "$s" ] && security="$s"

        local stripped="${line#vless://}"
        stripped=$(echo "$stripped" | sed 's/#.*//' | sed 's/?.*//')
        local hostport host port
        hostport=$(echo "$stripped" | sed 's/.*@//')
        case "$hostport" in
            "["*"]"*) host=$(echo "$hostport" | sed 's/\[\(.*\)\].*/\1/'); port=$(echo "$hostport" | sed 's/.*\]://') ;;
            *) host=$(echo "$hostport" | cut -d: -f1); port=$(echo "$hostport" | cut -d: -f2) ;;
        esac

        name=$(echo "$name" | sed 's/"/\\"/g')
        [ "$first" -eq 0 ] && servers="${servers},"
        first=0
        servers="${servers}{\"name\":\"${name}\",\"host\":\"${host}\",\"port\":${port:-443},\"transport\":\"${transport}\",\"security\":\"${security}\"}"
    done < "$filtered"

    servers="${servers}]"
    echo "{\"servers\":${servers},\"count\":${idx}}"
}

rpc_get_log() {
    local log_file lines
    log_file=$(get_config log_file "/var/log/vlessmanager.log")
    lines="${1:-50}"
    if [ -f "$log_file" ]; then
        local content
        content=$(tail -n "$lines" "$log_file" 2>/dev/null | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
        echo "{\"log\":\"${content}\"}"
    else
        echo '{"log":""}'
    fi
}

rpc_healthcheck() {
    /usr/bin/vlessmanager-urltest check
}

# ===================== MAIN =====================

main() {
    ensure_dirs

    case "$1" in
        start)
            [ "$(get_config enabled 0)" != "1" ] && { echo "Disabled"; return 0; }
            acquire_lock || return 1
            full_update; setup_cron
            release_lock ;;
        stop)
            acquire_lock || return 1
            stop_singbox; remove_network_interface
            crontab -l 2>/dev/null | grep -v "$PROG_NAME" | crontab - 2>/dev/null
            release_lock ;;
        restart)
            acquire_lock || return 1
            stop_singbox; sleep 2
            [ "$(get_config enabled 0)" = "1" ] && { full_update; setup_cron; }
            release_lock ;;
        update)
            acquire_lock || return 1
            full_update
            release_lock ;;
        cron_update)
            acquire_lock || return 1
            if fetch_subscription && filter_configs && generate_singbox_config; then
                if is_singbox_running; then
                    stop_singbox; sleep 1; start_singbox
                fi
            fi
            release_lock ;;
        status)     rpc_get_status ;;
        servers)    rpc_get_servers ;;
        log)        rpc_get_log "${2:-50}" ;;
        healthcheck) rpc_healthcheck ;;
        check)
            if is_singbox_running; then echo '{"running":true}'
            else echo '{"running":false}'; fi ;;
        version)    echo "{\"version\":\"${VERSION}\"}" ;;
        *)
            echo "Usage: $0 {start|stop|restart|update|status|servers|log|healthcheck|check|version}"
            return 1 ;;
    esac
}

main "$@"
